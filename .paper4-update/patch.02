+ -\nu(\alpha_m-\bar\beta_H).
+\end{equation}
+For the parameters in \eqref{eq:dimension-parameters},
+\begin{equation}\label{eq:Um-limit}
+ U_m=\left(\frac{cB^m}{\nu}\right)^{1/(m+1)},
+ \qquad \alpha_m\longrightarrow B.
 \end{equation}
 \end{lemma}
 
